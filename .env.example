# Pharma Strategies — environment variables
#
# Copy to .env.local for local work, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# --- Supabase (required for /apps data, lead capture and /admin) ---
# Public: inlined into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL (used for canonical URLs, sitemap and metadata) ---
# e.g. https://pharma-strategies.vercel.app — falls back to the production domain.
NEXT_PUBLIC_APP_URL=

# --- Email notifications for new demo requests (optional) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
